# ---------- .NET build output ----------
bin/
obj/
publish/

# ---------- packaged artifacts ----------
*.zip
!themes/**/*.zip

# ---------- IDE / tooling ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ---------- Node tooling (dev only, not shipped) ----------
node_modules/
package-lock.json

# ---------- runtime / logs ----------
*.log
nova.log
*.tmp
*.bak
*.broken-*.json
.cache/

# ---------- OS junk ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- local screenshots used during development ----------
_shots/
*.png.bak

# Keep the docs screenshots that the README links to.
!docs/screenshot-*.jpg

# ---------- theme previews are content, keep them ----------
!themes/**/assets/*

# dev-only ad-hoc probes
tools/_*.tmp.js
tools/__pycache__/

# ---------- release staging ----------
dist/

# legacy generated native weaving folder
legacy/costura64/
legacy/embedded/

# Fody regenerates this schema on every build
legacy/FodyWeavers.xsd

# ---------- bundled Magpie engine (binaries fetched, notices tracked) ----------
third_party/magpie/*.exe
third_party/magpie/*.dll
third_party/magpie/*.pri
third_party/magpie/effects/

# ---------- Rust / WebAssembly kernel ----------
# The compiled .wasm is committed (src/assets/nova_palette.wasm) so a plain
# dotnet build never needs a Rust toolchain; only the build products are ignored.
wasm/**/target/
