<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GUGUOVA</AssemblyName>
    <RootNamespace>NovaGameSpace</RootNamespace>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
    <Version>1.16.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Product>GUGUOVA (Legacy)</Product>
    <AssemblyTitle>GUGUOVA 游戏空间 · Legacy</AssemblyTitle>
    <Company>NOVA</Company>
    <Copyright>NOVA</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1774.30" GeneratePathProperty="true" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="..\App.xaml" Link="App.xaml" />
    <Page Include="..\MainWindow.xaml" Link="MainWindow.xaml" />
    <Compile Include="..\App.xaml.cs" Link="App.xaml.cs" />
    <Compile Include="..\MainWindow.xaml.cs" Link="MainWindow.xaml.cs" />
    <Compile Include="..\NativeBridge.cs" Link="NativeBridge.cs" />
    <Compile Include="..\Services\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\src\**\*" Link="src\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\themes\**\*" Link="themes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled GPLv3 upscaler; optional, fetched with tools/fetch-magpie.py. -->
    <Content Include="..\third_party\magpie\**\*" Condition="Exists('..\third_party\magpie\Magpie.exe')" Link="engine\magpie\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="embedded\assets.zip" LogicalName="NOVA.Assets.zip" Condition="Exists('embedded\assets.zip')" />
    <!-- Single-exe Magpie: extracted once under %LOCALAPPDATA% and run as its
         own process so the GPLv3 boundary stays intact. -->
    <EmbeddedResource Include="embedded\engine.zip" LogicalName="NOVA.Engine.zip" Condition="Exists('embedded\engine.zip')" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="NOVA.WebView2Loader.dll" />
  </ItemGroup>

  <Target Name="StageCosturaNative" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(MSBuildProjectDirectory)\costura64" />
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFiles="$(MSBuildProjectDirectory)\costura64\WebView2Loader.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
